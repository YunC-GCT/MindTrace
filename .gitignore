# ===== HarmonyOS build =====
oh_modules/
.hvigor/
build/
*.har

# Per-module build outputs
**/build/
**/oh_modules/

# ===== IDE / Editor =====
.idea/
.deveco/
*.iml
.vscode/

# ===== Local config (machine-specific) =====
local.properties
.env

# ===== Compiler =====
.cxx/
.clangd
.clang-format
.clang-tidy
.appanalyzer

# ===== Test runtime outputs =====
**/.test
test-results.xml

# ===== Logs =====
*.log
logs/

# ===== Python runtime caches =====
__pycache__/
*.py[cod]

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Build outputs of one-shot =====
*.app
*.apk
*.hap
*.ipa

# ===== Node (DevEco CLI use npm/yarn) =====
node_modules/
package-lock.json
# Subpackage (arkts-lint) needs its lockfile for CI reproducibility
!scripts/arkts-lint/package-lock.json

# ===== Resource caches =====
**/.cache/

# ===== Agent metadata =====
.reasonix/
.zcode/

# ===== One-off scratch (git-flow setup scripts / gh issue cache / PR bodies) =====
# 一次性产物,跑完即可删;不入 commit
.scratch/
.scratch_*

# ===== Research scratch (Phase 1 audit, cleanup after) =====
docs/research/_fetched/

# ===== HTML reports (rendered, not committed) =====
# Reports rendered from .md for human review. Source stays in .md.
docs/research/*.html
docs/architecture/*.html
