/**
 * TestCorpusBulk.ets — 规模测试用的扩充语料（纯数据，无 IO）
 *
 * 路径: entry/src/main/ets/debug/TestCorpusBulk.ets
 * 职责: 把测试语料从 25 条扩到 100 条，用来验证余弦阈值与重排触发线在语料变多后是否还稳。
 *       每条按「要点 / 说明 / 常见错误」三段写，和真实笔记的信息密度接近——
 *       只有标题和一句话的语料会把检索测成另一回事。
 * 依赖: 无。
 *
 * 约束: 标题必须与 TestCorpusSeed 不重复，否则判重会把它们并掉。
 */

export interface BulkNote {
  title: string;
  subject: string;
  summary: string;
  content: string;
}

export interface OodQuery {
  query: string;
}

function note(title: string, subject: string, summary: string,
  points: string, notes: string, mistakes: string): BulkNote {
  return {
    title: title,
    subject: subject,
    summary: summary,
    content: '## 要点\n' + points + '\n\n## 说明\n' + notes + '\n\n## 常见错误\n' + mistakes,
  };
}

